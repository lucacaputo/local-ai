{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "enabled_providers": ["local-ai"],
  "model": "local-ai/local-coder",
  "small_model": "local-ai/local-coder",
  "provider": {
    "local-ai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local AI router",
      "options": {
        "baseURL": "{env:LOCAL_AI_ROUTER_URL}/v1",
        "apiKey": "{env:LOCAL_AI_ROUTER_KEY}"
      },
      "models": {
        "local-coder": { "name": "Local Coder", "limit": { "context": 163840, "output": 32000 } }
      }
    }
  }
}
